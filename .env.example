# ── Pulse CLI Configuration ──────────────────────────────────────────────
# Copy this file to .env and fill in your values, or run `pulse configure`
# for an interactive setup wizard.
#
# PROVIDER:  One of: openai, kimi, openrouter, gemini, ollama
# API_KEY:   Your API key (not needed for Ollama — it runs locally)
# BASE_URL:  API endpoint (leave blank to use the provider default)
# MODEL:     Model name (leave blank to use the provider default)
# ──────────────────────────────────────────────────────────────────────────

PROVIDER=openai
API_KEY=sk-your-api-key-here
# BASE_URL=https://api.openai.com/v1
# MODEL=gpt-4o
