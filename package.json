{
  "name": "@ledgee/pulse-cli",
  "version": "1.0.3",
  "description": "Fast, provider-agnostic AI coding assistant — BYOK, any provider, all from your terminal.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "pulse": "./bin/pulse.js"
  },
  "scripts": {
    "start": "node bin/pulse.js",
    "pulse": "node bin/pulse.js",
    "prepack": "node -e \"try{require('fs').accessSync('.env')&&console.error('⚠ .env detected — remove before publishing')}catch(e){}\"",
    "test": "node -e \"require('./src/index')\""
  },
  "files": [
    "bin/",
    "src/",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    ".env.example",
    "!src/**/*.test.js"
  ],
  "keywords": [
    "cli",
    "ai",
    "coding-assistant",
    "chat",
    "openai",
    "kimi",
    "moonshot",
    "openrouter",
    "gemini",
    "ollama",
    "llm",
    "byok",
    "terminal",
    "developer-tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ledge829/Pulse-CLI.git"
  },
  "homepage": "https://github.com/Ledge829/Pulse-CLI#readme",
  "bugs": {
    "url": "https://github.com/Ledge829/Pulse-CLI/issues"
  },
  "author": {
    "name": "Pulse CLI",
    "url": "https://github.com/Ledge829/Pulse-CLI"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "ora": "^5.4.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
